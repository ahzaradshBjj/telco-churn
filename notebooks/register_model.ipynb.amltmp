{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "from azure.ai.ml import MLClient\n",
        "from azure.ai.ml.entities import Model\n",
        "from azure.ai.ml.constants import AssetTypes\n",
        "from azure.identity import DefaultAzureCredential"
      ],
      "outputs": [],
      "execution_count": 3,
      "metadata": {},
      "id": "eb9cc209-9a55-4feb-ac0a-9bf70e0a4c6a"
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Cargar métricas e hiperparámetros guardados\n",
        "import json\n",
        "\n",
        "with open('../outputs/metrics.json') as f:\n",
        "    metrics = json.load(f)\n",
        "\n",
        "with open ('../outputs/hyperparams.json') as f:\n",
        "    hyperparams = json.load(f)"
      ],
      "outputs": [],
      "execution_count": 5,
      "metadata": {},
      "id": "a6cb0753-fe9e-4646-8db3-9fe78b1ba544"
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Conectar a ws\n",
        "ml_client = MLClient.from_config(credential=DefaultAzureCredential())"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "Found the config file in: /config.json\nClass DeploymentTemplateOperations: This is an experimental class, and may change at any time. Please see https://aka.ms/azuremlexperimental for more information.\n"
        }
      ],
      "execution_count": 6,
      "metadata": {},
      "id": "dc21f6f5-060f-425e-958b-4210a6313d71"
    },
    {
      "cell_type": "code",
      "source": [
        "print(ml_client.workspace_name)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "mlw-churn-dev\n"
        }
      ],
      "execution_count": 7,
      "metadata": {},
      "id": "93e3f499-b5a6-45c9-9ddd-1ebbcba5a46f"
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Registrar modelo desde carpeta local\n",
        "model = Model(\n",
        "    path='../outputs/model.pkl',\n",
        "    type=AssetTypes.CUSTOM_MODEL,\n",
        "    name='telco-churn-model',\n",
        "    # version=2,\n",
        "    description='Telco customer churn prediction - HistGradientBoosting',\n",
        "    tags={\n",
        "        # Framework\n",
        "        'framework': 'scikit-learn',\n",
        "        'algorithm': 'HistGradientBoosting',\n",
        "\n",
        "        # Metricas\n",
        "        'accuracy': f\"{metrics['accuracy']:.4f}\",\n",
        "        'precision': f\"{metrics['precision']:.4f}\",\n",
        "        'recall': f\"{metrics['recall']:.4f}\",\n",
        "        'f1_score': f\"{metrics['f1_score']:.4f}\",\n",
        "\n",
        "        # Hiperparametros clave\n",
        "        'learning_rate': str(hyperparams['learning_rate']),\n",
        "        'max_depth': str(hyperparams['max_depth']),\n",
        "        'max_iter': str(hyperparams['max_iter']),\n",
        "        'class_weight': 'balanced',\n",
        "\n",
        "        # Configuración\n",
        "        'threshold': '0.3', \n",
        "\n",
        "        #\n",
        "        'stage': 'candidate',\n",
        "    }\n",
        ")\n",
        "\n",
        "registered_model = ml_client.models.create_or_update(model)\n",
        "\n",
        "print(f\"Modelo registrado: {registered_model.name}, versión: {registered_model.version}\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "Uploading model.pkl (< 1 MB): 100%|██████████| 725k/725k [00:00<00:00, 15.1MB/s]\n\n\n"
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Modelo registrado: telco-churn-model, versión: 3\n"
        }
      ],
      "execution_count": 14,
      "metadata": {},
      "id": "ccd3b290-0daa-4bc9-b6aa-7399df787c6d"
    },
    {
      "cell_type": "code",
      "source": [
        "# Registrar modelo desde ultimo job\n",
        "\n",
        "# 1. Obtener jobs y encontrar el último\n",
        "jobs = list(ml_client.jobs.list())\n",
        "\n",
        "# Filtrar por experiment name\n",
        "churn_jobs = [j for j in jobs if j.experiment_name == \"churn-prediction-training\"]\n",
        "\n",
        "# Ordenar por fecha (más reciente primero)\n",
        "churn_jobs.sort(key=lambda x: x.creation_context.created_at, reverse=True)\n",
        "\n",
        "latest_job = churn_jobs[0]\n",
        "print(f\"Job más reciente: {latest_job.name}, Status: {latest_job.status}\")\n",
        "\n",
        "# 2. Registrar modelo DESDE ese job\n",
        "from azure.ai.ml.entities import Model\n",
        "from azure.ai.ml.constants import AssetTypes\n",
        "\n",
        "model = Model(\n",
        "    path=f\"azureml://jobs/{latest_job.name}/outputs/artifacts/paths/outputs/model.pkl\",\n",
        "    type=AssetTypes.CUSTOM_MODEL,\n",
        "    name='telco-churn-model',\n",
        "    description='Churn model WITHOUT FeatureAdder',\n",
        "    tags={\n",
        "        'framework': 'scikit-learn',\n",
        "        'no_custom_transformers': 'true',\n",
        "        'class_weight': 'balanced',\n",
        "        'stage': 'production',\n",
        "    }\n",
        ")\n",
        "\n",
        "registered_model = ml_client.models.create_or_update(model)\n",
        "print(f\"Registrado: {registered_model.name} v{registered_model.version}\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Job más reciente: gentle_frame_ckh7d79mc6, Status: Completed\nRegistrado: telco-churn-model v5\n"
        }
      ],
      "execution_count": 8,
      "metadata": {
        "gather": {
          "logged": 1771438024679
        }
      },
      "id": "05f36057-fcad-415e-9583-2d20b679e4c5"
    },
    {
      "cell_type": "code",
      "source": [
        "model.tags['threshold'] = 'pending_analysis'\n",
        "ml_client.models.create_or_update(registered_model)"
      ],
      "outputs": [
        {
          "output_type": "execute_result",
          "execution_count": 10,
          "data": {
            "text/plain": "Model({'job_name': 'gentle_frame_ckh7d79mc6', 'intellectual_property': None, 'system_metadata': None, 'is_anonymous': False, 'auto_increment_version': False, 'auto_delete_setting': None, 'name': 'telco-churn-model', 'description': 'Churn model WITHOUT FeatureAdder', 'tags': {'framework': 'scikit-learn', 'no_custom_transformers': 'true', 'class_weight': 'balanced', 'stage': 'production', 'threshold': 'pending_analysis'}, 'properties': {}, 'print_as_yaml': False, 'id': '/subscriptions/9cbbe496-fe29-459a-a3d7-44790ebac1fb/resourceGroups/rg-churn-dev/providers/Microsoft.MachineLearningServices/workspaces/mlw-churn-dev/models/telco-churn-model/versions/5', 'Resource__source_path': '', 'base_path': '/mnt/batch/tasks/shared/LS_root/mounts/clusters/ci-churn-dev/code/Users/asandovh/telco-churn/notebooks', 'creation_context': <azure.ai.ml.entities._system_data.SystemData object at 0x7855a34787f0>, 'serialize': <msrest.serialization.Serializer object at 0x7855a3280310>, 'version': '5', 'latest_version': None, 'path': 'azureml://subscriptions/9cbbe496-fe29-459a-a3d7-44790ebac1fb/resourceGroups/rg-churn-dev/workspaces/mlw-churn-dev/datastores/workspaceartifactstore/paths/ExperimentRun/dcid.gentle_frame_ckh7d79mc6/outputs/model.pkl', 'datastore': None, 'utc_time_created': None, 'flavors': None, 'arm_type': 'model_version', 'type': 'custom_model', 'stage': 'Development', 'default_deployment_template': None})"
