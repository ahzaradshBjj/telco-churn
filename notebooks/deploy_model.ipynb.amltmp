{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "from azure.ai.ml import MLClient\n",
        "from azure.ai.ml.entities import (\n",
        "    ManagedOnlineEndpoint,\n",
        "    ManagedOnlineDeployment,\n",
        "    Model,\n",
        "    CodeConfiguration,\n",
        "    Environment\n",
        ")\n",
        "from azure.identity import DefaultAzureCredential\n",
        "from pathlib import Path\n",
        "import datetime"
      ],
      "outputs": [],
      "execution_count": 1,
      "metadata": {
        "gather": {
          "logged": 1771437123419
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Celda 2 - Conectar\n",
        "ml_client = MLClient.from_config(credential=DefaultAzureCredential())\n",
        "print(f\"Conectado: {ml_client.workspace_name}\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "Found the config file in: /config.json\n"
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Conectado: mlw-churn-dev\n"
        }
      ],
      "execution_count": 2,
      "metadata": {
        "gather": {
          "logged": 1771437125345
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Celda 3 - Crear endpoint\n",
        "endpoint_name = \"churn-asandoval-endpoint\"\n",
        "\n",
        "endpoint = ManagedOnlineEndpoint(\n",
        "    name=endpoint_name,\n",
        "    description=\"Telco churn prediction endpoint\",\n",
        "    auth_mode=\"key\",\n",
        ")\n",
        "\n",
        "ml_client.online_endpoints.begin_create_or_update(endpoint).result()\n",
        "print(f\" Endpoint creado: {endpoint_name}\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "/anaconda/envs/azureml_py310_sdkv2/lib/python3.10/site-packages/mlflow/__init__.py:41: UserWarning: Versions of mlflow (3.8.1) and child packages mlflow-skinny (3.5.0) are different. This may lead to unexpected behavior. Please install the same version of all MLflow packages.\n  mlflow.mismatch._check_version_mismatch()\n"
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": " Endpoint creado: churn-asandoval-endpoint\n"
        }
      ],
      "execution_count": 3,
      "metadata": {
        "gather": {
          "logged": 1771437190900
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Celda 4 - Crear deployment\n",
        "current_dir = Path.cwd()\n",
        "project_root = current_dir.parent if current_dir.name == 'notebooks' else current_dir\n",
        "\n",
        "# Crear environment (mismo que antes)\n",
        "env_final = Environment(\n",
        "    name=\"churn-env-final\",\n",
        "    description=\"Final environment with sklearn 1.3\",\n",
        "    conda_file={\n",
        "        \"channels\": [\"conda-forge\"],\n",
        "        \"dependencies\": [\n",
        "            \"python=3.10\",\n",
        "            \"pip\",\n",
        "            {\n",
        "                \"pip\": [\n",
        "                    \"numpy==1.23.5\",\n",
        "                    \"scikit-learn==1.3.0\",\n",
        "                    \"pandas==2.0.0\",\n",
        "                    \"joblib==1.3.0\",\n",
        "                    \"azureml-inference-server-http==1.5.0\",\n",
        "                ]\n",
        "            }\n",
        "        ]\n",
        "    },\n",
        "    image=\"mcr.microsoft.com/azureml/openmpi4.1.0-ubuntu20.04\",\n",
        ")\n",
        "\n",
        "env_final = ml_client.environments.create_or_update(env_final)\n",
        "print(f\"Environment: {env_final.name}:{env_final.version}\")\n",
        "\n",
        "# Deployment con modelo v4\n",
        "deployment = ManagedOnlineDeployment(\n",
        "    name=\"churn-deployment-final\",  # Nuevo nombre\n",
        "    endpoint_name=endpoint_name,\n",
        "    model=ml_client.models.get(name=\"telco-churn-model\", version=\"5\"),\n",
        "    code_configuration=CodeConfiguration(\n",
        "        code=str(project_root / \"src\"),\n",
        "        scoring_script=\"score.py\"\n",
        "    ),\n",
        "    environment=f\"{env_final.name}:{env_final.version}\",\n",
        "    instance_type=\"Standard_DS2_v2\",\n",
        "    instance_count=1,\n",
        ")\n",
        "\n",
        "ml_client.online_deployments.begin_create_or_update(deployment).result()\n",
        "print(f\"Deployment creado\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "Instance type Standard_DS2_v2 may be too small for compute resources. Minimum recommended compute SKU is Standard_DS3_v2 for general purpose endpoints. Learn more about SKUs here: https://learn.microsoft.com/azure/machine-learning/referencemanaged-online-endpoints-vm-sku-list\nCheck: endpoint churn-asandoval-endpoint exists\n"
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "..................................................................................Deployment creado\n"
        }
      ],
      "execution_count": 5,
      "metadata": {
        "gather": {
          "logged": 1771438935277
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#ml_client.online_deployments.begin_delete(\n",
        "#    name=\"churn-deployment-final\",\n",
        "#    endpoint_name=endpoint_name\n",
        "#).result()"
      ],
      "outputs": [],
