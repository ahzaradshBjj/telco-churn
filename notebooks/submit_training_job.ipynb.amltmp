    {
      "cell_type": "code",
      "source": [
        "# Determinar project root\n",
        "current_dir = Path.cwd()\n",
        "\n",
        "if current_dir.name == 'notebooks':\n",
        "    project_root = current_dir.parent\n",
        "else:\n",
        "    project_root = current_dir\n",
        "\n",
        "print(project_root)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "/mnt/batch/tasks/shared/LS_root/mounts/clusters/ci-churn-dev/code/Users/asandovh/telco-churn\n"
        }
      ],
