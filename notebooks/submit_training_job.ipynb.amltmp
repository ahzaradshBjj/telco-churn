        "from azure.ai.ml import MLClient, command, Input\n",
        "from azure.ai.ml.entities import Environment\n",
        "from azure.identity import DefaultAzureCredential\n",
        "from pathlib import Path"
      ],
      "outputs": [],
      "execution_count": 10,
      "metadata": {
        "gather": {
          "logged": 1771340462838
        }
      },
      "id": "b6605ac9-2dfd-4112-ac54-5cb2be33f193"
    },
    {
      "cell_type": "code",
      "source": [
        "ml_client = MLClient.from_config(credential=DefaultAzureCredential())\n",
        "\n",
        "print(f\"Conectado a workspace: {ml_client.workspace_name}\")\n",
        "print(f\"Resource group: {ml_client.resource_group_name}\")"
      ],
      "outputs": [
        {
